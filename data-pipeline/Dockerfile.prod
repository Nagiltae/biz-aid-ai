# 운영 이미지에는 실행 코드와 공통 계약을 넣는다. Secret·원본·모델은 build context에서 복사하지 않는다.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONPATH=/app/data-pipeline/src
WORKDIR /app
COPY data-pipeline/requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /tmp/requirements-api.txt \
    && useradd --create-home --uid 10001 bizaid
COPY data-pipeline/src /app/data-pipeline/src
COPY contracts /app/contracts
USER bizaid
EXPOSE 8000
# WHY: BGE-M3가 worker마다 복제된다. 실측 전에는 1개만 사용하고 운영 설정으로 변경한다.
CMD ["uvicorn", "biz_aid_pipeline.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
