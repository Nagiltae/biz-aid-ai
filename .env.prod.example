# 운영 설정 이름 안내. 실제 값은 사용자 관리 .env.prod에 작성한다. AWS 키는 쓰지 않고 EC2 IAM Role을 사용한다.
# 아래 모든 칸은 비어 있다. 설명의 기본값을 확인해 사용자가 필요한 값을 채운다.

# global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=

# Bedrock API 호출 region ap-northeast-2
BEDROCK_REGION=

# 일반·체험 계정당 하루 10회
BIZAID_AI_DAILY_LIMIT=

# 같은 실제 접속 IP의 계정들을 합쳐 하루 30회
BIZAID_AI_DAILY_LIMIT_PER_IP=

# 서비스 전체 하루 300회
BIZAID_AI_GLOBAL_DAILY_LIMIT=

# 서버 안 모델 artifact 디렉터리
BIZAID_MODEL_PATH=

# 접속 IP별 하루 회원가입 5개
BIZAID_SIGNUP_PER_IP_PER_DAY=

# 운영 체험 활성화 true
BIZAID_TRIAL_ENABLED=

# HTTPS 바인딩 기본 0.0.0.0:443
CADDY_HTTPS_BIND=

# HTTP 바인딩 기본 0.0.0.0:80
CADDY_HTTP_BIND=

# 운영 도메인 biz-aid.cloud
CADDY_SITE=

# 측정 후 worker 수; 기본 1
FASTAPI_WORKERS=

# Spring과 FastAPI 사이 인증 비밀값
INTERNAL_AI_API_KEY=

# JWT 서명 비밀값(사용자가 입력; 충분한 길이)
JWT_SECRET=

# 운영 DB 이름
MYSQL_DATABASE=

# RDS endpoint 주소
MYSQL_HOST=

# DB 접속 비밀번호(사용자가 입력; 출력 금지)
MYSQL_PASSWORD=

# MySQL 포트
MYSQL_PORT=

# FastAPI 컨테이너 안 RDS CA 인증서 경로 /certs/rds-ca.pem
MYSQL_SSL_CA=

# DB TLS 검증 모드, 운영 VERIFY_IDENTITY 권장
MYSQL_SSL_MODE=

# 서버 안 RDS CA 인증서 디렉터리
MYSQL_TLS_CERTS_PATH=

# 운영 DB 계정
MYSQL_USER=

# 검증된 V2 collection 정확한 이름
QDRANT_COLLECTION=

# Spring JDBC RDS CA truststore 파일 URL (예: file:/certs/rds-ca.p12)
MYSQL_TRUSTSTORE_URL=

# Spring JDBC truststore 형식 PKCS12
MYSQL_TRUSTSTORE_TYPE=

# 사용자가 만든 truststore의 비밀번호(출력 금지)
MYSQL_TRUSTSTORE_PASSWORD=

# 운영 검색 저장소 주소(기본 내부 Qdrant http://qdrant:6333)
QDRANT_URL=

# Docker Hub 개인 비공개 저장소: 사용자명/저장소명 (3서비스를 태그로 구분)
BIZAID_IMAGE_REPO=

# 새 배포마다 다른 태그. 예: 20261005-01
BIZAID_IMAGE_TAG=
