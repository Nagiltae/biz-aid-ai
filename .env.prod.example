# 운영 설정 이름 안내. 실제 값은 사용자 관리 .env.prod에 작성한다. AWS 키는 쓰지 않고 EC2 IAM Role을 사용한다.
# 공개된 운영 값은 실제 환경에 맞췄다. 비밀값과 사용자별 저장소·태그는 사용자가 직접 입력한다.

# global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock API 호출 region ap-northeast-2
BEDROCK_REGION=ap-northeast-2

# 일반·체험 계정당 하루 10회
BIZAID_AI_DAILY_LIMIT=10

# 같은 실제 접속 IP의 계정들을 합쳐 하루 30회
BIZAID_AI_DAILY_LIMIT_PER_IP=30

# 서비스 전체 하루 300회
BIZAID_AI_GLOBAL_DAILY_LIMIT=300

# 서버 안 모델 artifact 디렉터리
BIZAID_MODEL_PATH=/home/ubuntu/bizaid/models

# 접속 IP별 하루 회원가입 5개
BIZAID_SIGNUP_PER_IP_PER_DAY=5

# 운영 체험 활성화 true
BIZAID_TRIAL_ENABLED=true

# HTTPS 바인딩 기본 0.0.0.0:443
CADDY_HTTPS_BIND=0.0.0.0:443

# HTTP 바인딩 기본 0.0.0.0:80
CADDY_HTTP_BIND=0.0.0.0:80

# 운영 도메인 biz-aid.cloud
CADDY_SITE=biz-aid.cloud

# 측정 후 worker 수; 기본 1
FASTAPI_WORKERS=1

# Spring과 FastAPI 사이 인증 비밀값 — 사용자가 직접 입력
INTERNAL_AI_API_KEY=

# JWT 서명 비밀값 — 사용자가 직접 입력(충분한 길이)
JWT_SECRET=

# 운영 DB 이름
MYSQL_DATABASE=bizaid

# RDS endpoint 주소
MYSQL_HOST=bizaid-db.cb0ek4accq15.ap-southeast-2.rds.amazonaws.com

# DB 접속 비밀번호 — 사용자가 직접 입력(출력 금지)
MYSQL_PASSWORD=

# MySQL 포트
MYSQL_PORT=3306

# FastAPI 컨테이너 안 RDS CA 인증서 경로 /certs/rds-ca.pem
MYSQL_SSL_CA=/certs/rds-ca.pem

# DB TLS 검증 모드, 운영 VERIFY_IDENTITY 권장
MYSQL_SSL_MODE=VERIFY_IDENTITY

# 서버 안 RDS CA 인증서 디렉터리
MYSQL_TLS_CERTS_PATH=/home/ubuntu/bizaid/certs

# 운영 DB 계정
MYSQL_USER=bizaid_app

# 검증된 V2 collection 정확한 이름
QDRANT_COLLECTION=bizaid_v2_chunks_v1_228acdd12220

# Spring JDBC RDS CA truststore 파일 URL (예: file:/certs/rds-ca.p12)
MYSQL_TRUSTSTORE_URL=file:/certs/rds-ca.p12

# Spring JDBC truststore 형식 PKCS12
MYSQL_TRUSTSTORE_TYPE=PKCS12

# 신뢰저장소 비밀번호 — 사용자가 직접 입력(출력 금지)
MYSQL_TRUSTSTORE_PASSWORD=

# 운영 검색 저장소 주소(기본 내부 Qdrant http://qdrant:6333)
QDRANT_URL=http://qdrant:6333

# Docker Hub 개인 비공개 저장소: 사용자명/저장소명 (3서비스를 태그로 구분)
BIZAID_IMAGE_REPO=

# 새 배포마다 다른 태그. 예: 20261005-01
BIZAID_IMAGE_TAG=

# 실제 운영 서버 x86_64. ARM 서버를 별도로 쓰는 경우에만 linux/arm64로 바꾼다.
BIZAID_IMAGE_PLATFORM=linux/amd64

# EC2·RDS·S3 운영 region. Bedrock 호출 region과 구분한다.
AWS_REGION=ap-southeast-2

# 기존 문서 및 이번 deploy/<태그>/ 자료를 보관하는 공개 버킷 이름
AWS_S3_BUCKET=amazon-s3-biz-aid-bucket-695694684371-ap-southeast-2-an

# 원본 문서 prefix. 배포 자료 prefix(deploy/<태그>/)와 구분한다.
AWS_S3_PREFIX=biz-aid/documents
