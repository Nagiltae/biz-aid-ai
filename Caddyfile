# 개인정보인 접속 IP/요청 경로를 포함하는 proxy 오류 로그는 보내지 않는다. 생존 확인과 고정 앱 오류 코드로 점검한다.
{
	log default {
		exclude http.log.error
	}
}
# 운영은 스킴·www 없는 도메인을 쓴다. 리허설은 CADDY_SITE=localhost:80으로 HTTP만 사용한다.
{$CADDY_SITE:biz-aid.cloud} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy frontend:80 {
		# BOUNDARY: 외부에서 주장한 접속 IP·프로토콜은 버리고 실제 연결 값만 전달한다.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
# WHY: www도 사이트로 등록해야 HTTPS 인증서를 자동 발급하고 대표 주소로 이동시킬 수 있다.
www.{$CADDY_SITE:biz-aid.cloud} {
	redir https://{$CADDY_SITE:biz-aid.cloud}{uri} permanent
}
