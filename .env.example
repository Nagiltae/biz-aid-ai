# 사용자 관리 .env.dev / .env.prod의 설정 예시이며 실제 인증키는 Git에 넣지 않는다.
# Probe는 APP_PROFILE이나 Git Branch로 자동 선택하지 않고 --profile을 필수로 받는다.
APP_PROFILE=dev

BIZINFO_API_BASE_URL=https://apis.data.go.kr/1421000/bizinfo/pblancBsnsService
BIZINFO_SERVICE_KEY=
BIZINFO_DATA_TYPE=json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=biz_aid_dev
MYSQL_USER=biz_aid
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=amazon-s3-biz-aid-bucket-695694684371-ap-southeast-2-an
AWS_S3_PREFIX=biz-aid/documents
# dev Qdrant(Compose dev-vector). loopback 주소만 허용하며 비우면 http://127.0.0.1:6333을 쓴다.
QDRANT_URL=http://127.0.0.1:6333
# 모델 artifact 경로 BIZAID_DOCLING_ARTIFACTS_PATH는 이 파일이 아니라 process environment로만 읽는다.
# RAG 답변 LLM provider(현재 ollama만). 모델 tag는 `ollama list`에 실제 설치된 이름을 쓴다.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=10m
