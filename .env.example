# 사용자 관리 .env.dev / .env.prod의 설정 예시이며 실제 인증키는 Git에 넣지 않는다.
# Probe는 APP_PROFILE이나 Git Branch로 자동 선택하지 않고 --profile을 필수로 받는다.
APP_PROFILE=dev

BIZINFO_API_BASE_URL=https://apis.data.go.kr/1421000/bizinfo/pblancBsnsService
BIZINFO_SERVICE_KEY=
BIZINFO_DATA_TYPE=json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=biz_aid_dev
MYSQL_USER=biz_aid
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=amazon-s3-biz-aid-bucket-695694684371-ap-southeast-2-an
AWS_S3_PREFIX=biz-aid/documents
# dev Qdrant(Compose dev-vector). loopback 주소만 허용하며 비우면 http://127.0.0.1:6333을 쓴다.
QDRANT_URL=http://127.0.0.1:6333
# 모델 artifact 경로 BIZAID_DOCLING_ARTIFACTS_PATH는 이 파일이 아니라 process environment로만 읽는다.
# RAG 답변 LLM provider(현재 ollama만). 모델 tag는 `ollama list`에 실제 설치된 이름을 쓴다.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# LLM 호출 전체 기한(초). 계약 internal-api llm_call.deadline_seconds(75)보다 길게 줄 수 없다(Spring 응답 제한 90초).
OLLAMA_TIMEOUT_SECONDS=75
OLLAMA_KEEP_ALIVE=10m
# Spring Boot(backend) JWT 서명 키. 32byte 이상 무작위 값(예: openssl rand -base64 48)을 직접 넣고 Git에 올리지 않는다.
JWT_SECRET=
# Refresh Token Cookie의 Secure 속성. 로컬 http 개발은 false, https 배포에서는 true로 둔다.
REFRESH_COOKIE_SECURE=false
# Spring → FastAPI 서비스 간 인증 공유 키. Spring과 호스트 FastAPI가 같은 값을 읽는다(예: openssl rand -base64 32). Git에 올리지 않는다.
INTERNAL_AI_API_KEY=
# 선택: AI_BASE_URL, AI_CONNECT_TIMEOUT, AI_RESPONSE_TIMEOUT으로 Spring의 FastAPI 주소·제한시간을 바꿀 수 있다.
# 쓰지 않으면 줄 자체를 두지 않는다(빈 값은 기본값을 덮어쓴다). 기본: 직접 실행 127.0.0.1:8000, Compose host.docker.internal:8000, 연결 3s, 응답 90s.
# 검색이 읽을 Qdrant collection namespace. 비우면 V1 baseline collection, v2면 V2 서비스 범위 collection(적재 완료 후 전환).
QDRANT_COLLECTION_NAMESPACE=
# AI 실행 추적(LangSmith, 선택). true일 때만 FastAPI workflow 단계의 이름·시간·상태·개수·오류 코드를 보낸다(질문·기업정보·문서·prompt는 보내지 않음).
# LangChain 자동 추적 변수(LANGSMITH_TRACING, LANGCHAIN_TRACING_V2)는 쓰지 않는다. 켜도 workflow 안에서는 꺼진다.
BIZAID_TRACING_ENABLED=false
# LangSmith API 키. Git에 올리지 않는다.
LANGSMITH_API_KEY=
# 기록할 기존 LangSmith 프로젝트 이름(기본 biz-aid). 없는 이름이면 LangSmith가 새 프로젝트를 자동으로 만든다.
LANGSMITH_PROJECT=
# 선택: LangSmith 서버 주소(기본 SDK 주소). 쓰지 않으면 비워 둔다.
LANGSMITH_ENDPOINT=
